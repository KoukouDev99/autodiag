# ==============================================================================
# AutoDiag - Configuration Nginx Haute Performance & Sécurité (Production)
# Domaine : [TON-DOMAINE.fr]
# ==============================================================================

# 1. Redirection automatique HTTP vers HTTPS (Port 80 -> 443)
server {
    listen 80;
    listen [::]:80;
    server_name [TON-DOMAINE.fr] www.[TON-DOMAINE.fr];

    # Défi Let's Encrypt Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Serveur HTTPS Principal (Port 443)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name [TON-DOMAINE.fr] www.[TON-DOMAINE.fr];

    # Certificats SSL (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/[TON-DOMAINE.fr]/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/[TON-DOMAINE.fr]/privkey.pem;

    # Protocoles & Ciphers TLS Modernes (Mozilla Modern Guidelines)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 1.1.1.1 valid=300s;
    resolver_timeout 5s;

    # HSTS (Strict-Transport-Security : 1 an avec sous-domaines)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # En-têtes de sécurité complémentaires (en harmonie avec Helmet côté backend)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Racine des fichiers statiques compilés d'Angular
    root /var/www/autodiag/frontend/dist/frontend/browser;
    index index.html;

    # Compression Gzip & Brotli
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff2;

    # --------------------------------------------------------------------------
    # API Backend (Node.js / Express sur port 3000 géré par PM2)
    # --------------------------------------------------------------------------
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Transmission des IP et protocole pour Rate Limiting & Helmet
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts adaptés à l'inférence IA
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffer des requêtes
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
        client_max_body_size 1m;
    }

    # Health check direct pour load-balancer ou monitoring (Uptime Kuma, etc.)
    location /health {
        proxy_pass http://127.0.0.1:3000/api/health;
        access_log off;
    }

    # --------------------------------------------------------------------------
    # Fichiers statiques avec hachage (JS, CSS, Polices WOFF2) -> Cache long 1 an
    # --------------------------------------------------------------------------
    location ~* \.(?:css|js|woff2|woff|ttf|svg|png|jpg|jpeg|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404; # Retourne un vrai HTTP 404 si l'asset haché n'existe pas !
    }

    # Robots.txt et Sitemap.xml -> Cache court 1 jour
    location ~* (robots\.txt|sitemap\.xml)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # --------------------------------------------------------------------------
    # Routage Angular SPA (HTML) -> Aucun cache sur index.html pour les déploiements
    # --------------------------------------------------------------------------
    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        try_files $uri $uri/ /index.html;
    }

    # Page d'erreur personnalisée 50x
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

