# ===============================================
# AutoDiag - Variables d'environnement (Exemple)
# Copiez ce fichier vers .env et complétez les valeurs
# ===============================================

# Environnement (development | production)
NODE_ENV=production
PORT=3000

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=autodiag_user
DB_PASSWORD=[VOTRE_MOT_DE_PASSE_MYSQL_SECURISE]
DB_NAME=autodiag

# Configuration CORS (liste d'origines autorisées en production, séparées par des virgules)
CORS_ORIGIN=https://ton-domaine.fr,https://www.ton-domaine.fr

# Fournisseur d'IA & Conseiller Mécanique
# Provider supportés : 'groq' (recommandé), 'deepseek', 'openai_compatible', 'mock'
AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=15000

# Clé d'API Groq (console.groq.com)
GROQ_API_KEY=[VOTRE_CLE_API_GROQ_SECRETE]

# URL du microservice optionnel si utilisé
AI_SERVICE_URL=http://127.0.0.1:8001

