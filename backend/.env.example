# ===============================================
# AutoDiag Backend - Variables d'environnement
# ===============================================

NODE_ENV=production
PORT=3000

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=autodiag_user
DB_PASSWORD=[VOTRE_MOT_DE_PASSE_MYSQL_SECURISE]
DB_NAME=autodiag

# Configuration CORS
CORS_ORIGIN=https://ton-domaine.fr,https://www.ton-domaine.fr

# IA Groq Cloud
AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=15000
GROQ_API_KEY=[VOTRE_CLE_API_GROQ_SECRETE]

AI_SERVICE_URL=http://127.0.0.1:8001

